# ==============================================================================
# WhisperVideoSRT Configuration Environment File
# ==============================================================================

# Port on the host machine to bind the web server (Default: 8000)
PORT=8000

# Security access token / password for API protection when exposed to the Internet.
# If left empty, API is accessible without authentication.
# Example: API_ACCESS_TOKEN=MySecretToken12345
API_ACCESS_TOKEN=

# Maximum allowed video upload size in Megabytes (Default: 500)
UPLOAD_MAX_MB=500

# faster-whisper AI Model size:
# Options: tiny (39M), base (74M), small (244M), medium (769M), large-v3 (1.5G)
# 'base' or 'small' is recommended for smooth CPU operation.
WHISPER_MODEL=base

# Device and compute precision for faster-whisper:
# For CPU: DEVICE=cpu, COMPUTE_TYPE=int8 (fastest and lowest RAM)
# For NVIDIA GPU: DEVICE=cuda, COMPUTE_TYPE=float16
DEVICE=cpu
COMPUTE_TYPE=int8
CPU_THREADS=4

# Storage path for uploads and outputs inside the container
STORAGE_DIR=/data/storage
MODEL_CACHE_DIR=/root/.cache/huggingface

# Retention duration: automatically purges temporary videos and jobs older than N hours
TEMP_FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Optional AI Studio Platform parameters
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
